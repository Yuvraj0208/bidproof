{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (debug, breakpoints work)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "python": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Inspect the open PDF",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/inspect_pdf.py",
      "args": ["${file}", "--pages", "1-5", "--text"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "Current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ]
}
