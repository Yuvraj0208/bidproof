# Local-only working files are ignored via .git/info/exclude on the
# maintainer's machine, not here.

# --- secrets & environment ---
.env
.env.*
!.env.example
*.key
*.pem
infra/litellm/*.local.yaml

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- node / web ---
node_modules/
*.tsbuildinfo
apps/web/dist/
apps/web/.vite/
npm-debug.log*

# --- data, stores, artifacts ---
eval_report.json
*.log
uploads/
minio-data/
postgres-data/
pgdata/
.DS_Store
Thumbs.db
