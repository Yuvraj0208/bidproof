# =========================================================
#  Local working files — NEVER published to GitHub.
#  These stay on your machine; Claude Code still reads them.
# =========================================================
CLAUDE.md
docs/BUILD_PLAYBOOK.md
# local tool settings/cache
.claude/
# NOTE: gitignore has no inline comments — the old "pattern  # comment" lines
# never matched, so docs/SPEC.md and parking-lot.md are ALREADY TRACKED.
# To make either local-only again: git rm --cached <file>, then re-add its
# pattern here on a line of its own.

# --- secrets & environment ---
.env
.env.*
!.env.example
*.key
*.pem
infra/litellm/*.local.yaml

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- node / web ---
node_modules/
apps/web/dist/
apps/web/.vite/
npm-debug.log*

# --- data, stores, artifacts ---
*.log
uploads/
minio-data/
postgres-data/
pgdata/
.DS_Store
Thumbs.db
