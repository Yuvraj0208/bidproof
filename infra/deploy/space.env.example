# Every secret the hosted container needs. Paste each one into the host's
# secrets panel (Hugging Face: Space -> Settings -> Variables and secrets).
# Nothing here is read from a file in production — only from the environment.

# ===== Model roles (your existing OpenRouter keys; same as local .env) ======
LLM_SMALL_MODEL=
LLM_SMALL_API_BASE=
LLM_SMALL_API_KEY=
LLM_MID_MODEL=
LLM_MID_API_BASE=
LLM_MID_API_KEY=
LLM_STRONG_MODEL=
LLM_STRONG_API_BASE=
LLM_STRONG_API_KEY=
# Any long random string; the API uses it to talk to the in-container gateway.
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://127.0.0.1:4000
LLM_MAX_CONCURRENCY=4

# ===== Postgres (Neon) ======================================================
# Owner URL from the Neon dashboard, with the scheme changed to
# postgresql+asyncpg:// and "?sslmode=require" changed to "?ssl=require".
DATABASE_URL_OWNER=postgresql+asyncpg://<owner>:<password>@<host>/<db>?ssl=require
# Same host and db, but user bidproof_app and the password below.
DATABASE_URL=postgresql+asyncpg://bidproof_app:<APP_DB_PASSWORD>@<host>/<db>?ssl=require
# The app role's password. bootstrap_db.py creates the role with it on boot.
APP_DB_PASSWORD=

# ===== Object store (Backblaze B2 or Cloudflare R2; S3-compatible) =========
# B2: s3.<region>.backblazeb2.com and the bucket's region, e.g. us-east-005.
# R2: <account-id>.r2.cloudflarestorage.com and region "auto".
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_REGION=
MINIO_BUCKET_RAW=bidproof-tenders-raw

# ===== Tracing (optional; Langfuse Cloud free tier) ========================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== App ==================================================================
# The UI is served by the API itself, so only the public URL is needed here.
CORS_ORIGINS=https://<your-username>-bidproof.hf.space
SCOUT_ENABLED=false
CONDUCTOR_ENABLED=true
