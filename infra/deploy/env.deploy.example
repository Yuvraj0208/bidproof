# Copy to .env.deploy at the repo root (gitignored) and fill in. This is the
# only input the deploy tools need; everything else is derived from it and
# from the model keys already in .env.

# ---- The VM (Oracle Cloud Always Free, or any Ubuntu box) --------------------
# Public IP of the instance, the private key downloaded when it was created,
# and the login user (ubuntu on Canonical images).
VM_HOST=
VM_SSH_KEY=
VM_USER=ubuntu

# ---- Render (deploy_render.py; free web service, no OCR) ---------------------
# dashboard.render.com -> Account Settings -> API Keys -> Create API Key.
RENDER_API_KEY=

# ---- Hugging Face (only for deploy_space.py; Docker Spaces need PRO) ---------
HF_TOKEN=
HF_SPACE=

# ---- Neon: the database ------------------------------------------------------
# neon.tech -> project -> Connect (pooling OFF) -> copy the URL as shown.
NEON_URL=

# ---- Backblaze B2: the PDFs --------------------------------------------------
# Bucket page shows the endpoint, e.g. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=
B2_BUCKET=bidproof-tenders-raw
# Application key restricted to that bucket, read + write.
B2_KEY_ID=
B2_APP_KEY=

# ---- Optional ------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Generated on first run and written back here so a redeploy keeps them.
APP_DB_PASSWORD=
LITELLM_MASTER_KEY=
# The site login Caddy asks for (VM deploy). Set SITE_PASSWORD to choose it.
SITE_USER=bidproof
SITE_PASSWORD=
