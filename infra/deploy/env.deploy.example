# Copy to .env.deploy at the repo root (gitignored) and fill in. This is the
# only input the deploy tools need; everything else is derived from it and
# from the model keys already in .env.

# ---- Hugging Face: the container --------------------------------------------
# huggingface.co -> Settings -> Access Tokens -> New token, type "Write".
HF_TOKEN=
# <your-username>/bidproof. The Space is created if it does not exist.
HF_SPACE=

# ---- Neon: the database ------------------------------------------------------
# neon.tech -> project -> Connect (pooling OFF) -> copy the URL as shown.
NEON_URL=

# ---- Backblaze B2: the PDFs --------------------------------------------------
# Bucket page shows the endpoint, e.g. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=
B2_BUCKET=bidproof-tenders-raw
# Application key restricted to that bucket, read + write.
B2_KEY_ID=
B2_APP_KEY=

# ---- Optional ------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Generated on first run and written back here so a redeploy keeps them.
APP_DB_PASSWORD=
LITELLM_MASTER_KEY=
